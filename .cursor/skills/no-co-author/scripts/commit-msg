#!/bin/sh
# TO NEVER COAUTHOR WORK AGAIN!
# commit-msg hook: drop agent co-author / sign-off trailers.
msgfile="$1"
[ -f "$msgfile" ] || exit 0
tmp="${msgfile}.nocoauthor.$$"
grep -v -E '^(Co-authored-by:|Signed-off-by:[[:space:]]*Cursor)' "$msgfile" \
  | grep -v -E '^(Generated by|Assisted by)[[:space:]]+(Cursor|Claude|Grok)' \
  > "$tmp" || true
mv "$tmp" "$msgfile"
exit 0
